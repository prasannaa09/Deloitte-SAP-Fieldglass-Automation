# SAP Fieldglass Credentials & Configuration
SAP_URL=https://www.fieldglass.net
SAP_USERNAME=your_username_here
SAP_PASSWORD=your_password_here

# Directory Configurations
DOWNLOAD_DIR=downloads
REPORT_DIR=reports
SCREENSHOT_DIR=screenshots
LOG_DIR=logs

# Playwright Configuration
BROWSER_TYPE=chromium
HEADLESS=false
SLOW_MO=1000.0
DEFAULT_TIMEOUT=30000.0

# Session & Development Configuration
USE_SAVED_SESSION=true
AUTH_FILE_PATH=auth.json
KEEP_BROWSER_OPEN=true

# PostgreSQL Configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here
PG_DATABASE=fieldglass
